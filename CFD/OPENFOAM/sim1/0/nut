FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }
    outlet
    {
        type            zeroGradient;
    }
    freestream
    {
        type            calculated;
        value           uniform 0;
    }
    symmetry
    {
        type symmetryPlane;
    }
    ground
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
    "(body|.*Wheel)"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}


