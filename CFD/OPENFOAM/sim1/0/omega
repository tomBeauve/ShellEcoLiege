FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include    "$FOAM_CASE/constant/caseSettings"

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $omegaInlet;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            zeroGradient;
    }
    freestream
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    symmetry
    {
        type symmetryPlane;
    }
    ground
    {
        type            omegaWallFunction;
        value           $internalField;
    }
    "(body|.*Wheel)"
    {
        type            omegaWallFunction;
        value           $internalField;
    }
}


