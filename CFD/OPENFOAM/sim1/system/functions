FoamFile
{
    format      ascii;
    class       dictionary;
    object      functions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //



#includeFunc forceCoeffsIncompressible

#includeFunc time

#include    "$FOAM_CASE/constant/caseSettings"

yPlus
{
    type            yPlus;
    libs            ("libfieldFunctionObjects.so");
    U               U;              // velocity field
    nu              nu;
    patches         (body  ".*Wheel");
    writeControl    outputTime;
}

wallShearStress
{
    type            wallShearStress;
    libs            ("libutilityFunctionObjects.so");
    patches         (body ".*Wheel");
    writeControl    outputTime;
}
